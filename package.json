{
  "name": "typewriter",
  "version": "1.0.0",
  "private": true,
  "description": "打字机 — 面向 Windows 和 macOS 的纯文本编辑器",
  "author": "Typewriter",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "icon": "electron scripts/make-icon.cjs",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder --publish never",
    "pack:dir": "npm run build && electron-builder --dir --publish never",
    "verify": "node scripts/verify-pack.mjs",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@fontsource/courier-prime": "5.3.0",
    "@fontsource/cutive-mono": "5.3.0",
    "@fontsource/special-elite": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "40.10.2",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "9.39.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.187.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zustand": "5.0.16"
  },
  "engines": {
    "node": ">=24"
  }
}
